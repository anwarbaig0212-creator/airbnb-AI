<% layout("/layouts/boilerplate") %>
<% locals.pageTitle = status === 404 ? "Page not found" : "Something went wrong" %>

<section class="empty-state">
  <div class="empty-icon"><i class="fa-solid <%= status === 404 ? 'fa-map-location-dot' : 'fa-triangle-exclamation' %>"></i></div>
  <h1><%= status %></h1>
  <h2><%= status === 404 ? "We couldn't find that page" : "Something went wrong" %></h2>
  <p><%= message %></p>
  <a href="/listings" class="btn btn-primary">Back to listings</a>
</section>
