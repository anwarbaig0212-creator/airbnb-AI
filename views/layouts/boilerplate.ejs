<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.pageTitle ? locals.pageTitle + ' · StayAI' : 'StayAI · Find your perfect stay' %></title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧭</text></svg>">

  <!-- Bootstrap CSS (one version everywhere) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <%- include("../includes/navbar.ejs") %>

  <% const flashes = [].concat((success || []).map(m => ({ type: 'success', m })), (error || []).map(m => ({ type: 'danger', m }))); %>
  <% if (flashes.length) { %>
    <div class="container flash-wrap">
      <% flashes.forEach(function (f) { %>
        <div class="alert alert-<%= f.type %> alert-dismissible fade show" role="alert">
          <%= f.m %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% }) %>
    </div>
  <% } %>

  <main class="page-main">
    <div class="container">
      <%- body %>
    </div>
  </main>

  <%- include("../includes/footer.ejs") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="/js/script.js"></script>
</body>

</html>
