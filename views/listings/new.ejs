<% layout("/layouts/boilerplate") %>
<% locals.pageTitle = "New listing" %>

<div class="form-wrapper">
  <div class="form-card">
    <h1 class="form-heading">Create your new listing</h1>
    <p class="form-subtext">Share your space with travellers around the world.</p>

    <!-- AI helper: kept outside the <form> so its inputs are never submitted -->
    <div class="ai-helper">
      <h5><i class="fa-solid fa-wand-magic-sparkles"></i> AI helper</h5>
      <p class="muted">Fill these in and click “Generate”. The title, description and search tags are filled in for you. You can edit them before saving.</p>
      <div class="row g-2">
        <div class="col-md-6">
          <label class="form-label" for="ai-location">Location *</label>
          <input id="ai-location" class="form-control" placeholder="e.g. Anjuna, Goa" />
        </div>
        <div class="col-md-6">
          <label class="form-label" for="ai-propertyType">Property type</label>
          <input id="ai-propertyType" class="form-control" placeholder="e.g. apartment" />
        </div>
        <div class="col-md-4">
          <label class="form-label" for="ai-bedrooms">Bedrooms</label>
          <input id="ai-bedrooms" type="number" min="1" class="form-control" />
        </div>
        <div class="col-md-8">
          <label class="form-label" for="ai-amenities">Amenities (comma-separated)</label>
          <input id="ai-amenities" class="form-control" placeholder="WiFi, Pool, AC" />
        </div>
        <div class="col-md-6">
          <label class="form-label" for="ai-nearby">Nearby attractions</label>
          <input id="ai-nearby" class="form-control" placeholder="Baga Beach, flea market" />
        </div>
        <div class="col-md-6">
          <label class="form-label" for="ai-special">Special features</label>
          <input id="ai-special" class="form-control" placeholder="sea view balcony, pet friendly" />
        </div>
      </div>
      <button type="button" id="ai-generate-btn" class="btn btn-primary btn-sm mt-3">Generate with AI</button>
      <span id="ai-status" class="ms-2 ai-status" role="status"></span>
    </div>

    <form method="POST" action="/listings" class="listing-form needs-validation" novalidate>
      <%- include("../includes/listingFields", { listing: {} }) %>
      <div class="form-actions">
        <a href="/listings" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" data-submit-once>Add listing</button>
      </div>
    </form>
  </div>
</div>
<script src="/js/listing-form.js"></script>
