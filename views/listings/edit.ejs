<% layout("/layouts/boilerplate") %>
<% locals.pageTitle = "Edit listing" %>

<div class="form-wrapper">
  <div class="form-card">
    <h1 class="form-heading">Edit your listing</h1>
    <p class="form-subtext">Update the details below and save your changes.</p>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" class="listing-form needs-validation" novalidate>
      <%- include("../includes/listingFields", { listing }) %>
      <div class="form-actions">
        <a href="/listings/<%= listing._id %>" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" data-submit-once>Update listing</button>
      </div>
    </form>
  </div>
</div>
<script src="/js/listing-form.js"></script>
